GEMINI_API_KEY=isi-dengan-api-key-dari-Google-AI-Studio
GEMINI_MODEL=gemini-flash-latest
CACHE_TTL_SECONDS=3600

# Ad monetization (Google AdSense). Set ADS_ENABLED=true only after your
# AdSense account is approved and you have real slot IDs, otherwise the
# placeholder "Ad Space" boxes are shown instead (safe default).
ADS_ENABLED=false
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
AD_SLOT_HEADER=1111111111
AD_SLOT_SIDEBAR=2222222222
AD_SLOT_INCONTENT=3333333333
AD_SLOT_NATIVE=5555555555
AD_SLOT_FOOTER=4444444444
AD_SLOT_STICKY=6666666666
